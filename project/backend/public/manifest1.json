
{
  "_version": "1.12.0",
  "sap.app": {
    "id": "pm.fiori",
    "type": "application",
    "title": "Project Management Executive Dashboard",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "my.app.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "my.app.view",
        "controlId": "appControl",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": "",
          "target": "TargetMain"
        }
      ],
      "targets": {
        "TargetMain": {
          "viewName": "Main",
          "viewLevel": 1
        }
      }
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.suite.ui.commons": {},
        "sap.suite.ui.microchart": {},
        "sap.gantt": {}
      }
    }
  }
}

