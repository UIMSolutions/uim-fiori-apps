<mvc:View controllerName="geo.fiori.controller.App"
 xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:vbm="sap.ui.vbm">
 <App><Page title="Standorte" busy="{view>/busy}">
  <content>
   <VBox class="sapUiSmallMargin">
    <MessageStrip text="{view>/message}" type="Information" visible="{= !!${view>/message} }"/>
    <vbm:GeoMap id="geoMap" width="100%" height="70vh" centerPosition="11.576124;48.137154" zoomlevel="5">
     <vbm:vos><vbm:Spots items="{path:'/Locations',parameters:{$select:'ID,Name,Longitude,Latitude,Category',$orderby:'Name asc',$count:false}}">
      <vbm:Spot position="{parts:[{path:'Longitude'},{path:'Latitude'}],formatter:'.toPosition'}" text="{Name}" type="Success" click=".onSpotPress"/>
     </vbm:Spots></vbm:vos>
    </vbm:GeoMap>
   </VBox>
  </content>
 </Page></App>
</mvc:View>