{
  "sap.ui5": {
    "dependencies": {
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "viewType": "XML",
        "viewPath": "reqmgmt.view",
        "controlId": "fcl",
        "transition": "slide"
      },
      "routes": [
        {
          "name": "RouteBusinessReqs",
          "pattern": "business-requirements",
          "target": ["TargetBusinessReqList"]
        },
        {
          "name": "RouteBusinessReqDetail",
          "pattern": "business-requirements/{reqId}",
          "target": ["TargetBusinessReqList", "TargetBusinessReqDetail"]
        }
      ],
      "targets": {
        "TargetBusinessReqList": {
          "viewName": "BusinessReqList",
          "controlAggregation": "beginColumnPages"
        },
        "TargetBusinessReqDetail": {
          "viewName": "BusinessReqDetail",
          "controlAggregation": "midColumnPages"
        }
      }
    }
  }
}