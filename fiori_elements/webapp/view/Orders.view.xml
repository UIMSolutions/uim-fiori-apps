<mvc:View controllerName="vibe.demo.controller.Orders"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core">
	<Page showHeader="false">
		<Table id="table" mode="MultiSelect" growing="true" growingThreshold="20"
			items="{path: '/Orders', sorter: {path: 'OrderDate', descending: true}}">
			<headerToolbar>
				<OverflowToolbar>
					<Title text="{i18n>ordersTab}" />
					<ToolbarSpacer />
					<SearchField width="16rem" placeholder="{i18n>search}" search=".onSearch" />
					<Select id="sortField" width="10rem" selectedKey="OrderDate" change=".onSort" tooltip="{i18n>sortBy}">
						<core:Item key="OrderDate" text="{i18n>colDate}" />
						<core:Item key="ID" text="{i18n>colOrder}" />
						<core:Item key="Customer" text="{i18n>colCustomer}" />
						<core:Item key="Quantity" text="{i18n>colQuantity}" />
						<core:Item key="Total" text="{i18n>colTotal}" />
						<core:Item key="Status" text="{i18n>colStatus}" />
					</Select>
					<Button icon="sap-icon://excel-attachment" text="{i18n>export}" press=".onExport" tooltip="{i18n>exportTip}" />
					<Button icon="sap-icon://print" text="{i18n>print}" press=".onPrint" tooltip="{i18n>exportTip}" />
					<Button icon="sap-icon://add" text="{i18n>add}" type="Emphasized" press=".onAdd" />
					<ToggleButton id="sortDir" pressed="true" icon="sap-icon://sort-descending" tooltip="{i18n>sortDirection}" press=".onSort" />
				</OverflowToolbar>
			</headerToolbar>
			<columns>
				<Column><Text text="{i18n>colOrder}" /></Column>
				<Column><Text text="{i18n>colCustomer}" /></Column>
				<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colDate}" /></Column>
				<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colQuantity}" /></Column>
				<Column hAlign="End"><Text text="{i18n>colTotal}" /></Column>
				<Column><Text text="{i18n>colStatus}" /></Column>
				<Column width="6rem" hAlign="End"><Text text="" /></Column>
			</columns>
			<items>
				<ColumnListItem>
					<ObjectIdentifier title="{path: 'ID', type: 'sap.ui.model.odata.type.Int32', formatOptions: {groupingEnabled: false}}" />
					<Text text="{Customer}" />
					<Text text="{OrderDate}" />
					<Text text="{Quantity}" />
					<ObjectNumber number="{Total}" unit="{Currency}" />
					<ObjectStatus text="{Status}"
						state="{= ${Status} === 'Shipped' ? 'Success' : ${Status} === 'Cancelled' ? 'Error' : 'Warning'}" />
					<HBox justifyContent="End">
						<Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>edit}" press=".onEdit" />
						<Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>delete}" press=".onDelete" />
					</HBox>
				</ColumnListItem>
			</items>
		</Table>
	</Page>
</mvc:View>
