<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog contentWidth="28rem">
		<f:SimpleForm editable="true" layout="ResponsiveGridLayout">
			<Label text="{i18n>colCustomer}" required="true" />
			<Input value="{form>/Customer}" />
			<Label text="{i18n>colDate}" />
			<DatePicker value="{form>/OrderDate}" valueFormat="yyyy-MM-dd" displayFormat="medium" />
			<Label text="{i18n>colProduct}" />
			<Input type="Number" value="{form>/ProductID}" />
			<Label text="{i18n>colQuantity}" />
			<Input type="Number" value="{form>/Quantity}" />
			<Label text="{i18n>colTotal}" />
			<Input type="Number" value="{form>/Total}" />
			<Label text="Currency" />
			<Input value="{form>/Currency}" maxLength="3" />
			<Label text="{i18n>colStatus}" />
			<Select selectedKey="{form>/Status}">
				<core:Item key="Open" text="Open" />
				<core:Item key="Shipped" text="Shipped" />
				<core:Item key="Cancelled" text="Cancelled" />
			</Select>
		</f:SimpleForm>
		<beginButton><Button text="{i18n>save}" type="Emphasized" press=".onSave" /></beginButton>
		<endButton><Button text="{i18n>cancel}" press=".onCancel" /></endButton>
	</Dialog>
</core:FragmentDefinition>
