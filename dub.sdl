// Metadata
name "uim-fioriapps"
description "A collection of SAP Fiori Apps for the D programming language, built on top of the uim-framework. This package provides a set of UI components and utilities for building modern desktop applications with a focus on SAP Fiori design principles."
homepage "https://www.....de/uim/fioriapps"
authors "Ozan Nurettin Süel" "UI Manufaktur (R.I.P)"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

// Target
targetType "library"
targetName "uim-fioriapps"

// External dependencies
dependency "uim-framework" version="~>26.8.3"
dependency "vibe-d" version="~>0.10.3"

// Internal Dependencies
dependency ":fiori" version="*"

// Source files
sourceFiles "./source/package.d"

// Subpackages
subPackage "fiori"

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations" "debugInfo"