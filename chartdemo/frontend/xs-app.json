{
  "welcomeFile": "/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "backend-destination"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "directory": ".",
      "index": "index.html"
    }
  ]
}