<mvc:View controllerName="my.app.controller.components.Breadcrumbs" 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m">
    
    <VBox class="sapUiMediumMargin">
        <Title text="Interactive Breadcrumbs Testbed" class="sapUiSmallMarginBottom" />
        
        <MessageStrip 
            text="Breadcrumbs allow users to navigate back up the hierarchical path of pages or workspace folders in an application." 
            type="Information" 
            showIcon="true" 
            class="sapUiMediumMarginBottom" />

        <Panel headerText="Hierarchical Navigation Trail" class="sapUiMediumMarginBottom">
            <VBox class="sapUiSmallMargin" spacing="1rem">
                <Breadcrumbs id="myBreadcrumbs" itemClicked="onBreadcrumbClicked">
                    <links>
                        <Link text="Workspace Home" press="onLinkPress" />
                        <Link text="Component Explorer" press="onLinkPress" />
                        <Link text="sap.m Library" press="onLinkPress" />
                        <Link text="Breadcrumbs Control" press="onLinkPress" />
                    </links>
                </Breadcrumbs>
            </VBox>
        </Panel>

        <Label id="breadcrumbsStatusLabel" text="Status: Ready (Click any breadcrumb link above)" design="Bold" />
    </VBox>
</mvc:View>