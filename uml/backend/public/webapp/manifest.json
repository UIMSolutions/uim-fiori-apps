{
  "_version": "1.65.0",
  "sap.app": {
    "id": "uml",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/UmlService/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "uml.view.Root",
      "type": "XML",
      "id": "root"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.ui.core": {}
      }
    },
    "models": {
      "": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "serviceUrl": "/odata/v4/UmlService/",
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "vm": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "uml.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "uml.view",
        "controlId": "rootApp",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "home",
          "pattern": "",
          "target": "Home"
        },
        {
          "name": "workspace",
          "pattern": "workspace",
          "target": "Workspace"
        },
        {
          "name": "library",
          "pattern": "library",
          "target": "Library"
        },
        {
          "name": "insights",
          "pattern": "insights",
          "target": "Insights"
        }
      ],
      "targets": {
        "Home": {
          "viewName": "Home"
        },
        "Workspace": {
          "viewName": "App"
        },
        "Library": {
          "viewName": "Library"
        },
        "Insights": {
          "viewName": "Insights"
        }
      }
    }
  }
}
