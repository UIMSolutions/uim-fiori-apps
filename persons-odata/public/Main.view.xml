<mvc:View
    controllerName="personapp.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    height="100%">
    <Page title="Personenverwaltung (vibe.d + SAP Fiori OData V4)">
        <content>
            <Panel headerText="Neue Person anlegen" expandable="true" expanded="true">
                <f:SimpleForm editable="true" layout="ColumnLayout">
                    <Label text="Name" />
                    <Input value="{newPerson>/Name}" />
                    <Label text="E-Mail" />
                    <Input value="{newPerson>/Email}" />
                    <Label text="Rolle" />
                    <Input value="{newPerson>/Role}" />
                    <Button text="Speichern" type="Emphasized" press="onAddPerson" />
                </f:SimpleForm>
            </Panel>
            <Table id="personTable" items="{/Persons}">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Personenliste (OData V4)" level="H2"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="ID" /></Column>
                    <Column><Text text="Name" /></Column>
                    <Column><Text text="E-Mail" /></Column>
                    <Column><Text text="Rolle" /></Column>
                    <Column hAlign="End"><Text text="Aktion" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{ID}" />
                            <ObjectIdentifier title="{Name}" />
                            <Text text="{Email}" />
                            <Text text="{Role}" />
                            <Button icon="sap-icon://delete" type="Reject" press="onDeletePerson" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>