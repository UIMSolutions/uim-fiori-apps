{
	"_version": "1.65.0",
	"sap.app": {
		"id": "launchpad.frontend",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				"",
				"en"
			]
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"dataSources": {
			"launchpadService": {
				"uri": "/odata/v4/launchpad/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0"
				}
			}
		}
	},
	"sap.cloud": {
		"public": true,
		"service": "launchpad.demo"
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "launchpad.frontend.view.App",
			"type": "XML",
			"id": "app",
			"async": true
		},
		"dependencies": {
			"minUI5Version": "1.120.0",
			"libs": {
				"sap.m": {},
				"sap.f": {},
				"sap.tnt": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"models": {
			"": {
				"dataSource": "launchpadService",
				"preload": true,
				"settings": {
					"synchronizationMode": "None",
					"operationMode": "Server",
					"autoExpandSelect": true,
					"groupId": "$auto"
				}
			},
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "launchpad.frontend.i18n.i18n",
					"supportedLocales": [
						"",
						"en"
					]
				}
			}
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewType": "XML",
				"viewPath": "launchpad.frontend.view",
				"controlId": "mainNavContainer",
				"controlAggregation": "pages",
				"transition": "slide",
				"async": true
			},
			"routes": [
				{
					"name": "home",
					"pattern": "",
					"target": "home"
				},
				{
					"name": "products",
					"pattern": "products",
					"target": "products"
				},
				{
					"name": "reports",
					"pattern": "reports",
					"target": "reports"
				},
				{
					"name": "settings",
					"pattern": "settings",
					"target": "settings"
				}
			],
			"targets": {
				"home": {
					"viewName": "Home"
				},
				"products": {
					"viewName": "Products"
				},
				"reports": {
					"viewName": "Reports"
				},
				"settings": {
					"viewName": "Settings"
				}
			}
		},
		"flexBundle": false
	}
}