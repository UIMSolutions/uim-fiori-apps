{
  "xsappname": "launchpad-demo-xsapp",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Display",
      "description": "Display product and report data"
    },
    {
      "name": "$XSAPPNAME.Manage",
      "description": "Create, edit and delete products"
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "Read-only launchpad access",
      "scope-references": [
        "$XSAPPNAME.Display"
      ]
    },
    {
      "name": "Manager",
      "description": "Maintainer access for launchpad data",
      "scope-references": [
        "$XSAPPNAME.Display",
        "$XSAPPNAME.Manage"
      ]
    }
  ]
}
