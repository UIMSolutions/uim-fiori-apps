{
  "_version": "1.12.0",
  "sap.app": {
    "id": "projects.app",
    "type": "application",
    "title": "Projekte App",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "projects.app.view.App",
      "type": "XML",
      "async": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "groupId": "$direct"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "projects.app.view",
        "controlId": "app",
        "async": true
      },
      "routes": [
        {
          "name": "Master",
          "pattern": "",
          "target": ["TargetMaster", "TargetDetail"]
        },
        {
          "name": "Detail",
          "pattern": "Projects/{projectId}",
          "target": ["TargetMaster", "TargetDetail"]
        }
      ],
      "targets": {
        "TargetMaster": {
          "viewName": "Master",
          "viewLevel": 1,
          "controlAggregation": "masterPages"
        },
        "TargetDetail": {
          "viewName": "Detail",
          "viewLevel": 2,
          "controlAggregation": "detailPages"
        }
      }
    }  
  }
}