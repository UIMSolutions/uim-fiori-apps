<mvc:View
    controllerName="projects.app.controller.Master"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="Projekte">
        <subHeader>
            <Toolbar>
                <Button text="Neues Projekt" press="onOpenAddProjectDialog" icon="sap-icon://add" />
            </Toolbar>
        </subHeader>
        <List id="projectList"
              items="{/Projects}" 
              mode="Delete" 
              delete="onDeleteProject">
            <items>
                <StandardListItem
                    title="{Name}"
                    description="{Description}"
                    type="Navigation"
                    press="onSelect" />
            </items>
        </List>
    </Page>
</mvc:View>