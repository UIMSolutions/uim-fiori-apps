<mvc:View
    controllerName="projects.app.controller.Master"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="Projekte">
        <subHeader>
            <Toolbar>
                <Button text="Neues Projekt" press="onOpenAddProjectDialog" icon="sap-icon://add" />
            </Toolbar>
        </subHeader>
        <List items="{path: '/projects', templateShareable: false}" 
              id="projectList" 
              selectionChange="onSelect" 
              mode="Delete" 
              delete="onDeleteProject">
            <StandardListItem
                title="{name}"
                description="{description}"
                type="Navigation"
                press="onSelect" />
        </List>
    </Page>
</mvc:View>