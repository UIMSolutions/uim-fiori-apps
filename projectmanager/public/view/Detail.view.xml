<mvc:View
    controllerName="projects.app.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="{project>/Name}">
        <content>
            <ObjectHeader title="{project>/Name}" intro="{project>/Description}" />
            <Table items="{path: 'project>/Todos', templateShareable: false}" headerText="Aufgaben (Todos)">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Aufgaben" />
                        <ToolbarSpacer />
                        <Button text="Neues Todo" press="onOpenAddTodoDialog" icon="sap-icon://add" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="ID" /></Column>
                    <Column><Text text="Aufgabe" /></Column>
                    <Column><Text text="Status" /></Column>
                    <Column width="5em"><Text text="Aktion" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{project>Id}" />
                            <Text text="{project>Title}" />
                            <ObjectStatus 
                                text="{= ${project>Completed} ? 'Erledigt' : 'Offen' }" 
                                state="{= ${project>Completed} ? 'Success' : 'Warning' }" />
                            <Button icon="sap-icon://delete" type="Reject" press="onDeleteTodo" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>