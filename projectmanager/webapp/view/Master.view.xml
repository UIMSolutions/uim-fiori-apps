<mvc:View
    controllerName="projects.app.controller.Master"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="Projekte">
        <subHeader>
            <Toolbar>
                <Button text="Neues Projekt" press="onOpenAddProjectDialog" icon="sap-icon://add" />
            </Toolbar>
        </subHeader>
        <List id="projectList" items="{/Projects}">
            <items>
                <StandardListItem 
                    title="{Name}" 
                    description="{Description}" 
                    type="Navigation" 
                    press="onItemPress" />
            </items>
        </List>
    </Page>
</mvc:View>