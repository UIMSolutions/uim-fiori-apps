name "projectmanager"
description "Base library SAP projectmanager Apps"
homepage "https://www.....de/uim/projectmanager"
authors "Ozan Nurettin Süel"
copyright "Copyright © 2018 - 2026, ONS"
license "Apache-2.0"

dependency "uim-framework" version="~>26.8.3"
dependency "uim-fioriapps:fiori" path=".."

targetType "executable"
targetName "uim-projectmanager"
targetPath "build"



configuration "default" {
	targetType "executable"
}
configuration "modules" {
	targetType "executable"
	versions "show_module"
}
configuration "tests" {
	targetType "library"
	versions "show_module" "show_test"
}
configuration "inits" {
	targetType "library"
	versions "show_module" "show_init"
}
configuration "calls" {
	targetType "library"
	versions "show_module" "show_test" "show_function"
}
configuration "verbose" {
	targetType "library"
	versions "show_module" "show_test" "show_init" "show_function"
}
