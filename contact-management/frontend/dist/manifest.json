{
	"_version": "1.12.0",
	"sap.app": {
		"id": "contact.manager",
		"type": "application",
		"title": "Kontaktverwaltung",
		"dataSources": {
			"contactRemote": {
				"uri": "/api/v1/",
				"type": "JSON"
			}
		}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "contact.manager.view.App",
			"type": "XML",
			"async": true,
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.108.0",
			"libs": {
				"sap.m": {},
				"sap.f": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"models": {
			"": {
				"type": "sap.ui.model.json.JSONModel"
			}
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewType": "XML",
				"viewPath": "contact.manager.view",
				"controlId": "appContainer",
				"controlAggregation": "pages",
				"async": true
			},
			"routes": [
				{
					"name": "Dashboard",
					"pattern": "",
					"target": "Dashboard"
				},
				{
					"name": "MasterDetail",
					"pattern": "contacts",
					"target": "MasterDetail"
				}
			],
			"targets": {
				"Dashboard": {
					"viewName": "Dashboard"
				},
				"MasterDetail": {
					"viewName": "MasterDetail"
				}
			}
		},
		"flexBundle": false
	}
}