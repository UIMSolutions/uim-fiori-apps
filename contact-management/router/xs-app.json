{
  "welcomeFile": "/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/api/v1/(.*)$",
      "target": "/api/v1/$1",
      "destination": "backend-api",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources"
    }
  ]
}