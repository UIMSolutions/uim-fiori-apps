{
  "_version": "1.32.0",
  "sap.app": {
    "id": "ea.architecture.manager",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": ["", "de", "en", "tr"]
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "ea.architecture.manager.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.viz": {},
        "sap.ui.core": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "updateGroupId": "$auto"
        }
      },
      "resources": {
        "js": [
          { "uri": "thirdparty/docx.js" },
          { "uri": "thirdparty/FileSaver.js" }
        ]
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "ea.architecture.manager.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "login",
          "pattern": "",
          "target": "login"
        },
        {
          "name": "home",
          "pattern": "home",
          "target": "launchpad"
        },
        {
          "name": "base_show",
          "pattern": "base",
          "target": "baseMasterDetail"
        },
        {
          "name": "base_edit",
          "pattern": "base",
          "target": "baseMasterDetail"
        },
        {
          "name": "base_import",
          "pattern": "base",
          "target": "baseMasterDetail"
        },
        {
          "name": "base_export",
          "pattern": "base",
          "target": "baseExport"
        },
        {
          "name": "base_analyze",
          "pattern": "base",
          "target": "baseMasterDetail"
        },
        {
          "name": "architecture_show",
          "pattern": "architecture",
          "target": "architectureMasterDetail"
        },
        {
          "name": "architecture_edit",
          "pattern": "architecture",
          "target": "architectureMasterDetail"
        },
        {
          "name": "architecture_import",
          "pattern": "architecture",
          "target": "architectureMasterDetail"
        },
        {
          "name": "architecture_export",
          "pattern": "architecture",
          "target": "architectureMasterDetail"
        },
        {
          "name": "architecture_analyze",
          "pattern": "architecture",
          "target": "architectureMasterDetail"
        },
        {
          "name": "solution_show",
          "pattern": "solution",
          "target": "solutionMasterDetail"
        },
        {
          "name": "solution_edit",
          "pattern": "solution",
          "target": "solutionMasterDetail"
        },
        {
          "name": "solution_import",
          "pattern": "solution",
          "target": "solutionMasterDetail"
        },
        {
          "name": "solution_export",
          "pattern": "solution",
          "target": "solutionExport"
        },
        {
          "name": "solution_analyze",
          "pattern": "solution",
          "target": "solutionMasterDetail"
        },
        {
          "name": "interface_show",
          "pattern": "interface",
          "target": "interfaceMasterDetail"
        },
        {
          "name": "interface_edit",
          "pattern": "interface",
          "target": "interfaceMasterDetail"
        },
        {
          "name": "interface_import",
          "pattern": "interface",
          "target": "interfaceMasterDetail"
        },
        {
          "name": "interface_export",
          "pattern": "interface",
          "target": "interfaceExport"
        },
        {
          "name": "interface_analyze",
          "pattern": "interface",
          "target": "interfaceMasterDetail"
        },
        {
          "name": "block_import",
          "pattern": "import",
          "target": "blockImport"
        },
        {
          "name": "block_export",
          "pattern": "export",
          "target": "blockExport"
        },
        {
          "name": "block_search",
          "pattern": "reporting",
          "target": "reporting"
        },
        {
          "name": "admin_repair",
          "pattern": "admin/configuration",
          "target": "configuration"
        },
        {
          "name": "admin_user",
          "pattern": "admin/users",
          "target": "userManagement"
        },
        {
          "name": "admin_history",
          "pattern": "admin/history",
          "target": "loggingHistory"
        }
      ],
      "targets": {
        "login": {
          "viewName": "Login"
        },
        "launchpad": {
          "viewName": "Home"
        },
        "baseMasterDetail": {
          "viewName": "BaseMasterDetail"
        },
        "baseExport": {
          "viewName": "BaseExport"
        },
        "architectureMasterDetail": {
          "viewName": "ArchitectureMasterDetail"
        },
        "architectureExport": {
          "viewName": "ArchitectureExport"
        },
        "solutionMasterDetail": {
          "viewName": "SolutionMasterDetail"
        },
        "solutionExport": {
          "viewName": "SolutionExport"
        },
        "interfaceMasterDetail": {
          "viewName": "InterfaceMasterDetail"
        },
        "interfaceExport": {
          "viewName": "InterfaceExport"
        },
        "blockImport": {
          "viewName": "BlockImport"
        },
        "blockExport": {
          "viewName": "BlockExport"
        },
        "reporting": {
          "viewName": "Reporting"
        },
        "configuration": {
          "viewName": "Configuration"
        },
        "userManagement": {
          "viewName": "UserManagement"
        },
        "loggingHistory": {
          "viewName": "LoggingHistory"
        }
      }
    }
  }
}
