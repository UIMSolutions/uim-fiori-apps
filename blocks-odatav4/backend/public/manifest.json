{
  "_version": "1.32.0",
  "sap.app": {
    "id": "ea.architecture.manager",
    "type": "application",
    "dataSources": {
      "mainService": {
        "uri": "http://127.0.0.1:8080/odata/v4/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "ea.architecture.manager.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.f": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "updateGroupId": "$auto"
        }
      },
      "resources": {
        "js": [
          { "uri": "thirdparty/docx.js" },
          { "uri": "thirdparty/FileSaver.js" }
        ]
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "ea.architecture.manager.view",
        "controlId": "appControl",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "home",
          "pattern": "",
          "target": "launchpad"
        },
        {
          "name": "base_show",
          "pattern": "base",
          "target": "baseMasterDetail"
        },
        {
          "name": "base_edit",
          "pattern": "base",
          "target": "baseMasterDetail"
        },
        {
          "name": "base_import",
          "pattern": "base",
          "target": "baseMasterDetail"
        },
        {
          "name": "base_export",
          "pattern": "base",
          "target": "baseMasterDetail"
        },
        {
          "name": "base_analyze",
          "pattern": "base",
          "target": "baseMasterDetail"
        },
        {
          "name": "architecture_show",
          "pattern": "architecture",
          "target": "architectureMasterDetail"
        },
        {
          "name": "architecture_edit",
          "pattern": "architecture",
          "target": "architectureMasterDetail"
        },
        {
          "name": "architecture_import",
          "pattern": "architecture",
          "target": "architectureMasterDetail"
        },
        {
          "name": "architecture_export",
          "pattern": "architecture",
          "target": "architectureMasterDetail"
        },
        {
          "name": "architecture_analyze",
          "pattern": "architecture",
          "target": "architectureMasterDetail"
        },
        {
          "name": "solution_show",
          "pattern": "solution",
          "target": "solutionMasterDetail"
        },
        {
          "name": "solution_edit",
          "pattern": "solution",
          "target": "solutionMasterDetail"
        },
        {
          "name": "solution_import",
          "pattern": "solution",
          "target": "solutionMasterDetail"
        },
        {
          "name": "solution_export",
          "pattern": "solution",
          "target": "solutionMasterDetail"
        },
        {
          "name": "solution_analyze",
          "pattern": "solution",
          "target": "solutionMasterDetail"
        },
        {
          "name": "interface_show",
          "pattern": "interface",
          "target": "interfaceMasterDetail"
        },
        {
          "name": "interface_edit",
          "pattern": "interface",
          "target": "interfaceMasterDetail"
        },
        {
          "name": "interface_import",
          "pattern": "interface",
          "target": "interfaceMasterDetail"
        },
        {
          "name": "interface_export",
          "pattern": "interface",
          "target": "interfaceMasterDetail"
        },
        {
          "name": "interface_analyze",
          "pattern": "interface",
          "target": "interfaceMasterDetail"
        }
      ],
      "targets": {
        "launchpad": {
          "viewName": "Home"
        },
        "baseMasterDetail": {
          "viewName": "BaseMasterDetail"
        },
        "architectureMasterDetail": {
          "viewName": "ArchitectureMasterDetail"
        },
        "solutionMasterDetail": {
          "viewName": "SolutionMasterDetail"
        },
        "interfaceMasterDetail": {
          "viewName": "InterfaceMasterDetail"
        }
      }
    }
  }
}
