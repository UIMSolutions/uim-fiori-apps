<mvc:View controllerName="ea.architecture.manager.controller.BlockExport"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page title="Architektur-Bausteine Exportieren">
        <!-- headerContent>
            <core:Fragment fragmentName="ea.architecture.manager.view.fragment.HeaderContent" type="XML" />
        </headerContent -->
        <content>
            <VBox class="sapUiMediumMargin">
                <f:SimpleForm editable="true" layout="ColumnLayout" title="Export-Einstellungen">
                    <f:content>
                        <Label text="Baustein-Typ auswählen" />
                        <Select id="blockTypeSelect" selectedKey="BaseBlocks" width="100%">
                            <items>
                                <core:Item xmlns:core="sap.ui.core" key="ArchitectureBlocks" text="Architecture Blocks" />
                                <core:Item xmlns:core="sap.ui.core" key="BaseBlocks" text="Base Blocks" />
                                <core:Item xmlns:core="sap.ui.core" key="SolutionBlocks" text="Solution Blocks" />
                                <core:Item xmlns:core="sap.ui.core" key="InterfaceBlocks" text="Interface Blocks" />
                            </items>
                        </Select>

                        <Label text="Aktion" />
                        <Button text="Als Excel exportieren" icon="sap-icon://excel-attachment" type="Emphasized" press=".onExportExcelPress" />
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
    </Page>
</mvc:View>