<mvc:View
    controllerName="ea.architecture.manager.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="Enterprise Architecture Launchpad">
        <content>
            <HBox class="sapUiSmallMargin">

                <GenericTile 
                    header="Grundbausteine" 
                    subheader="Verwaltung &amp; Overview" 
                    press=".onNavigateTo('base')"
                    class="sapUiTinyMarginEnd">
                    <tileContent>
                        <TileContent>
                            <ImageContent src="sap-icon://product" />
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile 
                    header="Architekturbausteine" 
                    subheader="Verwaltung &amp; Overview" 
                    press=".onNavigateTo('architecture')"
                    class="sapUiTinyMarginEnd">
                    <tileContent>
                        <TileContent>
                            <ImageContent src="sap-icon://building" />
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile 
                    header="Lösungsbausteine" 
                    subheader="Systeme &amp; Software" 
                    press=".onNavigateTo('solution')"
                    class="sapUiTinyMarginEnd">
                    <tileContent>
                        <TileContent>
                            <ImageContent src="sap-icon://system-technologies" />
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile 
                    header="Schnittstellen" 
                    subheader="APIs &amp; Integrationen" 
                    press=".onNavigateTo('interface')">
                    <tileContent>
                        <TileContent>
                            <ImageContent src="sap-icon://connected" />
                        </TileContent>
                    </tileContent>
                </GenericTile>

            </HBox>
        </content>
    </Page>
</mvc:View>