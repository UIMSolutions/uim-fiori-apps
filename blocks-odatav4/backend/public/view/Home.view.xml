                <VBox id="groupArchitecture" class="sapUiSmallMarginBottom">
                    <Title text="Auswertung" level="H2" titleStyle="H3" class="sapUiTinyMarginBottom" />

                    <f:GridContainer snapToRow="true">
                        <f:layout>
                            <f:GridContainerSettings rowSize="11rem" columnSize="11rem" gap="1rem" />
                        </f:layout>
                        <f:items>
                            <GenericTile header="Statistik" subheader="Berichtswesen" frameType="OneByOne" press=".onNavigateTo('block', 'search')">
                                <tileContent><TileContent><ImageContent src="sap-icon://business-objects-experience" /></TileContent></tileContent>
                            </GenericTile>
                            <GenericTile header="Qualität" subheader="Datenoptimierung" frameType="OneByOne" press=".onNavigateTo('architecture', 'analyze')">
                                <tileContent><TileContent><ImageContent src="sap-icon://badge" /></TileContent></tileContent>
                            </GenericTile>
                            <GenericTile header="Fehler" subheader="Inhaltliche Suche" frameType="OneByOne" press=".onNavigateTo('architecture', 'show')">
                                <tileContent><TileContent><ImageContent src="sap-icon://vehicle-repair" /></TileContent></tileContent>
                            </GenericTile>
                        </f:items>
                    </f:GridContainer>
                </VBox>

                <VBox id="groupExchange" class="sapUiSmallMarginBottom">
                    <Title text="Datenaustausch" level="H2" titleStyle="H3" class="sapUiTinyMarginBottom" />

                    <f:GridContainer snapToRow="true">
                        <f:layout>
                            <f:GridContainerSettings rowSize="11rem" columnSize="11rem" gap="1rem" />
                        </f:layout>
                        <f:items>
                            <GenericTile header="Importieren" subheader="Excel, CSV" frameType="OneByOne" press=".onNavigateTo('block', 'import')">
                                <tileContent><TileContent><ImageContent src="sap-icon://upload" /></TileContent></tileContent>
                            </GenericTile>
                            <GenericTile header="Exportieren" subheader="Excel, CSV" frameType="OneByOne" press=".onNavigateTo('block', 'export')">
                                <tileContent><TileContent><ImageContent src="sap-icon://download" /></TileContent></tileContent>
                            </GenericTile>
                            <GenericTile header="Drucken" subheader="Mehrere Elemente" frameType="OneByOne" press=".onNavigateTo('block', 'print')">
                                <tileContent><TileContent><ImageContent src="sap-icon://print" /></TileContent></tileContent>
                            </GenericTile>
                        </f:items>
                    </f:GridContainer>
                </VBox>

                <VBox id="groupAdmin" class="sapUiSmallMarginBottom">
                    <Title text="Administration" level="H2" titleStyle="H3" class="sapUiTinyMarginBottom" />

                    <f:GridContainer snapToRow="true">
                        <f:layout>
                            <f:GridContainerSettings rowSize="11rem" columnSize="11rem" gap="1rem" />
                        </f:layout>
                        <f:items>
                            <GenericTile header="Konfiguration" subheader="Anpassungen" frameType="OneByOne" press=".onNavigateTo('admin', 'repair')">
                                <tileContent><TileContent><ImageContent src="sap-icon://wrench" /></TileContent></tileContent>
                            </GenericTile>
                            <GenericTile header="Benutzer" subheader="Verwaltung" frameType="OneByOne" press=".onNavigateTo('admin', 'user')">
                                <tileContent><TileContent><ImageContent src="sap-icon://user-settings" /></TileContent></tileContent>
                            </GenericTile>
                        </f:items>
                    </f:GridContainer>
