<mvc:View controllerName="ea.architecture.manager.controller.InterfaceMasterDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m">
    <f:FlexibleColumnLayout id="fcl" layout="OneColumn">

        <!-- MASTER SPALTE -->
        <f:beginColumnPages>
            <Page title="Schnittstellenbausteine">
                <headerContent>
                    <Button icon="sap-icon://home" press=".onNavHome" />
                </headerContent>
                <content>
                    <!-- OData v4 Binding mit $filter -->
                    <List id="masterList" items="{
                            path: '/InterfaceBlocks',
                            parameters: {
                                '$filter': 'Type eq \'Interface\''
                            }
                        }" mode="SingleSelectMaster" itemPress=".onListItemPress">
                        <StandardListItem title="{Name}" description="{ID}" type="Navigation" />
                    </List>
                </content>
            </Page>
        </f:beginColumnPages>

        <!-- DETAIL SPALTE -->
        <f:midColumnPages>
            <Page title="Details" id="detailPage">
                <content>
                    <!-- OData v4 Context Binding in der Detailansicht -->
                    <ObjectHeader title="{Name}" number="{ID}" numberUnit="Status: {Status}">
                        <attributes>
                            <ObjectAttribute title="Typ" text="{Type}" />
                            <ObjectAttribute title="Beschreibung" text="{Description}" />
                        </attributes>
                    </ObjectHeader>
                </content>
            </Page>
        </f:midColumnPages>

    </f:FlexibleColumnLayout>
</mvc:View>