<mvc:View
    controllerName="ea.architecture.manager.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:tnt="sap.tnt">
    
    <tnt:ToolPage id="toolPage">
        <tnt:header>
            <f:ShellBar
                title="EA Architecture Manager"
                secondTitle="Dashboard"
                showNavButton="true"
                navButtonPressed=".onToggleSideNav"
                showNotifications="true"
                notificationsPressed=".onNotificationsPressed">
                <f:profile>
                    <Avatar press=".onLogout" />
                </f:profile>
            </f:ShellBar>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation itemSelect=".onSideNavSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem text="Launchpad" icon="sap-icon://home" key="Home" />
                    <tnt:NavigationListItem text="Architecture Blocks" icon="sap-icon://table-view" key="ArchitectureBlocks" />
                    <tnt:NavigationListItem text="Cards Overview" icon="sap-icon://grid" key="CardsOverview" />
                    <tnt:NavigationListItem text="Einstellungen" icon="sap-icon://action-settings" key="Settings" />
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <!-- Der Router setzt die Views in den App-Container -->
            <App id="app" />
        </tnt:mainContents>
    </tnt:ToolPage>
    
</mvc:View>