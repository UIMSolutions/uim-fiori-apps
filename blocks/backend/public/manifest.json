{
  "_version": "1.12.0",
  "sap.app": {
    "id": "ea.architecture.manager",
    "type": "application"
  },
  "sap.ui5": {
    "models": {
      "notifications": {
        "dataSource": "mainService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },
    "rootView": {
      "viewName": "ea.architecture.manager.view.App",
      "type": "XML",
      "async": true,
      "id": "appRoot"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.integration": {},
        "sap.tnt": {}
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "ea.architecture.manager.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "Home",
          "pattern": "",
          "target": "Home"
        },
        {
          "name": "ArchitectureBlocks",
          "pattern": "blocks",
          "target": "ArchitectureBlocks"
        },
        {
          "name": "CardsOverview",
          "pattern": "cards",
          "target": "CardsOverview"
        },
        {
          "name": "Settings",
          "pattern": "settings",
          "target": "Settings"
        }
      ],
      "targets": {
        "Home": {
          "viewName": "Home",
          "viewLevel": 1
        },
        "ArchitectureBlocks": {
          "viewName": "ArchitectureBlocks",
          "viewLevel": 2
        },
        "CardsOverview": {
          "viewName": "CardsOverview",
          "viewLevel": 2
        },
        "Settings": {
          "viewName": "Settings",
          "viewLevel": 2
        }
      }
    }
  }
}