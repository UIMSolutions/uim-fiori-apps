{
  "_version": "1.65.0",
  "sap.app": {
    "id": "requirements",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/RequirementsService/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {},
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "requirements.view.Root",
      "type": "XML",
      "id": "root"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.layout": {}
      }
    },
    "models": {
      "": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "serviceUrl": "/odata/v4/RequirementsService/",
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "requirements.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "requirements.view",
        "controlId": "rootApp",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "home",
          "pattern": "",
          "target": "Home"
        },
        {
          "name": "projects",
          "pattern": "projects",
          "target": "Projects"
        },
        {
          "name": "business",
          "pattern": "business-requirements",
          "target": "BusinessRequirements"
        },
        {
          "name": "solution",
          "pattern": "solution-requirements",
          "target": "SolutionRequirements"
        }
      ],
      "targets": {
        "Home": {
          "viewName": "Home"
        },
        "Projects": {
          "viewName": "Projects"
        },
        "BusinessRequirements": {
          "viewName": "BusinessRequirements"
        },
        "SolutionRequirements": {
          "viewName": "SolutionRequirements"
        }
      }
    }
  }
}
