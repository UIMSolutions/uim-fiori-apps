<mvc:View
  controllerName="requirements.controller.Home"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:layout="sap.ui.layout.cssgrid"
>
  <Page title="Anforderungsmanagement" class="rmHomePage">
    <subHeader>
      <Toolbar design="Solid">
        <Title text="Requirement Shell" level="H4" />
        <ToolbarSpacer />
        <Button text="Projekte" type="Transparent" press="onNavProjects" />
        <Button text="Geschäftsanforderungen" type="Transparent" press="onNavBusiness" />
        <Button text="Lösungsanforderungen" type="Transparent" press="onNavSolution" />
      </Toolbar>
    </subHeader>

    <content>
      <VBox class="rmHero sapUiResponsiveContentPadding">
        <Title text="Fiori 3 Cockpit für Anforderungen" level="H1" />
        <Text text="Verwalte Projekte, Geschäftsanforderungen und Lösungsanforderungen über OData v4 auf vibe.d." />
      </VBox>

      <layout:CSSGrid
        class="rmGrid sapUiResponsiveContentPadding"
        gridTemplateColumns="repeat(auto-fit, minmax(260px, 1fr))"
        gridGap="1rem"
      >
        <GenericTile header="Projekte verwalten" subheader="Projektstamm, Beschreibung und Übersicht" press="onNavProjects" class="rmCard">
          <tileContent>
            <TileContent>
              <content><NumericContent value="01" scale="STEP" /></content>
            </TileContent>
          </tileContent>
        </GenericTile>

        <GenericTile header="Geschäftsanforderungen" subheader="Business Needs pro Projekt pflegen" press="onNavBusiness" class="rmCard">
          <tileContent>
            <TileContent>
              <content><NumericContent value="02" scale="STEP" /></content>
            </TileContent>
          </tileContent>
        </GenericTile>

        <GenericTile header="Lösungsanforderungen" subheader="Solution Requirements zu Business Needs" press="onNavSolution" class="rmCard">
          <tileContent>
            <TileContent>
              <content><NumericContent value="03" scale="STEP" /></content>
            </TileContent>
          </tileContent>
        </GenericTile>
      </layout:CSSGrid>
    </content>
  </Page>
</mvc:View>
